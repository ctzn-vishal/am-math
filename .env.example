# Gemini API key. Server-side only — never expose this to the browser.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Local SQLite file. Swap for a libsql:// URL to sync to Turso.
DATABASE_URL="file:./sage.db"

# Shared secret guarding /api/tutor. Any random string; the app sends it from the server
# only. Without it a leaked deployment URL would spend your API quota for strangers.
TUTOR_ACCESS_SECRET=""
