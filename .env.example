# Gemini API key. Server-side only — never exposed to the browser.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Database. Turso (libsql) is what this is built for: it works locally and on a serverless
# host with the same credentials. Create one with `turso db create`, then paste both values
# here on ONE line each — a wrapped token reads as empty.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# With no Turso credentials, a local SQLite file is used. Fine for development; it CANNOT
# work on Vercel, where the filesystem is ephemeral, and the app refuses to start there
# rather than silently discarding a student's progress.
# DATABASE_URL="file:./sage.db"

# Shared secret guarding /api/tutor. REQUIRED in production: without it a leaked
# deployment URL spends your Gemini quota for anyone who finds it.
TUTOR_ACCESS_SECRET=""
